<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HelpDesk</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark shadow-lg sticky-top">
        <div class="container">

            <a class="navbar-brand fw-bold fs-4"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-headset"></i>

                HelpDesk
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbar">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbar">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-speedometer2"></i>

                            Dashboard

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Ticket"
                           asp-action="Index">

                            <i class="bi bi-ticket-perforated"></i>

                            Tickets

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="btn btn-primary ms-lg-3"
                           asp-controller="Ticket"
                           asp-action="Create">

                            <i class="bi bi-plus-circle"></i>

                            Raise Ticket

                        </a>

                    </li>

                </ul>

            </div>

        </div>
    </nav>

    <main class="container mt-4 mb-5">

        @RenderBody()

    </main>

    <footer class="mt-5 py-4 border-top">

        <div class="container text-center">

            <h5 class="fw-bold text-primary mb-2">
                <i class="bi bi-headset"></i>
                HelpDesk Management System
            </h5>

            <p class="text-muted mb-1">
                Built using ASP.NET Core MVC • Web API • Entity Framework Core • SQL Server
            </p>

            <small class="text-secondary">
                © @DateTime.Now.Year All Rights Reserved
            </small>

        </div>

    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>